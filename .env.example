# Backend only. Leave false until both migrations and staging checks are complete.
WG_GUEST_ENABLED=false
# Generate each secret independently with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set INTERNAL_PROXY_SECRET on both FastAPI and the Vercel server (never NEXT_PUBLIC).
INTERNAL_PROXY_SECRET=
GUEST_IP_HMAC_SECRET=
# Vercel server only: HTTPS FastAPI origin; keep existing Supabase and account API settings.
WAVEGUIDE_BACKEND_URL=

# Backend optional overrides. Rate windows are aligned UTC windows, not sliding windows.
WG_CREATE_LIMIT=3
WG_SUCCESS_LIMIT=15
WG_HOUR_LIMIT=30
WG_ATTEMPT_LIMIT=10
WG_CONCURRENT=12
WG_MINUTE_BUDGET=120
WG_DAY_BUDGET=4000
WG_GUEST_MAX_CHARS=1500
WG_CHAT_TIMEOUT_SECONDS=240
WG_MAX_PROMPT_CHARS=750000
